<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.yokeos</groupId>
        <artifactId>yokeos</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>yokeos-storage</artifactId>
    <name>YokeOS Storage</name>
    <description>持久化：SQLite + Spring Data JPA 仓储（sessions、tool_invocations、llm_calls、JpaScheduledTaskStore）。地基只预留审计两表 DDL；数据源与仓储随第 16+ 节落地。</description>

    <dependencies>
        <dependency>
            <groupId>com.yokeos</groupId>
            <artifactId>yokeos-core</artifactId>
        </dependency>
        <!-- 技 §9.1：SQLite + Spring Data JPA；表结构唯一权威是手工脚本 db/schema-001-audit.sql（宪法 7）。
             community-dialects 提供 SQLiteDialect——JPA+SQLite 选型的落地件，版本随 Boot 管理的 hibernate 对齐。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-community-dialects</artifactId>
        </dependency>
        <!-- 第 18 节（research D7）：JpaSessionManager 序列化 messages_json 直接使用，补显式
             （版本不写——根 pom jackson-bom 接管，002 D7 同款）；17 节 core 已显式、此处随动。 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
