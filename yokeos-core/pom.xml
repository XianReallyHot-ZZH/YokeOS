<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.yokeos</groupId>
        <artifactId>yokeos</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>yokeos-core</artifactId>
    <name>YokeOS Core</name>
    <description>核心抽象与契约：YokeTool、Session、Profile、AgentLoader、ContextLoader、ReActLoop、PromptBuilder、ToolExecutor、AgentService、AgentScheduler、AgentLifecycleService、ScheduledTaskStore。不依赖任何内部模块——契约由此下发，下游模块实现。</description>

    <dependencies>
        <!-- frontmatter 解析（AgentLoader，宪法 8）与结构化日志 API；版本随 Boot parent。 -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>
        <!-- JsonNode 参数形态（YokeTool.execute / ToolExecutor 解析，第 17 节拍板②）；
             版本走根 pom jackson-bom dependencyManagement，不落字面量（research D7，实施偏差）。 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- Spring 调度设施（TaskScheduler/CronTrigger，宪法 4 唯一明文例外的承载）：版本随 Boot parent
             BOM，非新第三方坐标——core 此前仅在 test 域经 starter-test 间接可见（25 节实施偏差，记验收报告）。 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <!-- SpotBugs 注解：record + 不可变副本场景的 EI_EXPOSE_REP 类型级误报就地标注 -->
        <dependency>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-annotations</artifactId>
            <version>${spotbugs.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
