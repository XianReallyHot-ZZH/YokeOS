<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.yokeos</groupId>
        <artifactId>yokeos</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>yokeos-tool</artifactId>
    <name>YokeOS Tool</name>
    <description>核心能力四（工具），宪法 5 三合一模块：内置 Tool（File/Shell/Http/Memory/Notify）、MCP Client、ToolRegistry、Sandbox 接口 + WhitelistSandbox、NotifyChannelAdapter 接口 + WebhookNotifyAdapter。随第 19/20/24 节落地。</description>

    <dependencies>
        <dependency>
            <groupId>com.yokeos</groupId>
            <artifactId>yokeos-core</artifactId>
        </dependency>
        <!-- @Tool schema 生成管道 + ToolCallback 载体（宪法 2 允许的第二件事；第 20 节起消费） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-model</artifactId>
        </dependency>
        <!-- MCP Java SDK（stdio 同步客户端 McpSyncClient，合宪法 4；版本根 pom 显式钉） -->
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp</artifactId>
        </dependency>
        <!-- mcp_servers.yaml 解析（技 §6.4；Boot 管版本） -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>
        <!-- SpotBugs 注解：ShellTools COMMAND_INJECTION 类告警的就地抑制（yokeos-core 同款 provided） -->
        <dependency>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-annotations</artifactId>
            <version>${spotbugs.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
