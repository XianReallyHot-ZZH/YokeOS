<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.yokeos</groupId>
    <artifactId>yokeos</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>YokeOS</name>
    <description>Enterprise Agent Harness OS</description>

    <properties>
        <java.version>21</java.version>

        <!-- Versions locked by docs/TechnicalSolution.md §1.2. The foundation consumes none of
             them yet (the dependencies themselves land with section 16+); they are pinned here
             so every module resolves the same version when a section pulls them in. -->
        <spring-ai.version>1.1.8</spring-ai.version>
        <picocli.version>4.7.6</picocli.version>
        <sqlite-jdbc.version>3.53.2.1</sqlite-jdbc.version>

        <!-- Foundation infrastructure -->
        <springdoc.version>2.6.0</springdoc.version>
        <logstash-logback.version>7.4</logstash-logback.version>

        <!-- CVE-patch overrides on the same Boot 3.5.16 baseline. jackson-bom 2.21.5 /
             log4j2 2.25.5 mirror the reference implementation's pins (constitution 9);
             tomcat goes beyond them: the reference pins 10.1.57, but CVEs disclosed after
             that pin still score ≥8 on it, so this takes the newest 10.1.x patch line
             (10.1.59) that clears the gate. These property names are Boot parent's own;
             bump them only together with a fresh dependency-check run, never ad hoc. -->
        <jackson-bom.version>2.21.5</jackson-bom.version>
        <log4j2.version>2.25.5</log4j2.version>
        <tomcat.version>10.1.59</tomcat.version>

        <!-- Quality / format / security gates: version combination mirrored from the reference
             implementation (constitution 9: 结构照抄). This exact set is proven on JDK 21 with
             Boot 3.5.x; do not bump entries individually — P3C 2.1.1 pins PMD 6.x, see the PMD
             plugin comment below. -->
        <spotless.version>2.43.0</spotless.version>
        <maven-pmd-plugin.version>3.21.2</maven-pmd-plugin.version>
        <pmd.version>6.55.0</pmd.version>
        <p3c.version>2.1.1</p3c.version>
        <maven-checkstyle-plugin.version>3.5.0</maven-checkstyle-plugin.version>
        <checkstyle.version>10.18.2</checkstyle.version>
        <spotbugs-maven-plugin.version>4.8.6.4</spotbugs-maven-plugin.version>
        <spotbugs.version>4.8.6</spotbugs.version>
        <findsecbugs.version>1.13.0</findsecbugs.version>
        <dependency-check.version>12.2.2</dependency-check.version>
        <nvd.datafeed.url>https://dependency-check.github.io/DependencyCheck_Builder/nvd_cache/</nvd.datafeed.url>

        <!-- OWASP Dependency-Check is skipped by default for fast local builds and enabled in CI. -->
        <owasp.skip>true</owasp.skip>
        <!-- Integration tests stay opt-in (@Tag("integration") excluded by default; run with
             -Dgroups=integration -DexcludedGroups=). AI 编程指南 §5.1. -->
        <excludedGroups>integration</excludedGroups>
    </properties>

    <modules>
        <module>yokeos-core</module>
        <module>yokeos-provider</module>
        <module>yokeos-memory</module>
        <module>yokeos-tool</module>
        <module>yokeos-channel-cli</module>
        <module>yokeos-web</module>
        <module>yokeos-storage</module>
        <module>yokeos-cli</module>
        <module>yokeos-boot</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Internal modules: every cross-module dependency goes through here so module
                 versions stay ${project.version} everywhere downstream. -->
            <dependency>
                <groupId>com.yokeos</groupId>
                <artifactId>yokeos-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yokeos</groupId>
                <artifactId>yokeos-provider</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yokeos</groupId>
                <artifactId>yokeos-memory</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yokeos</groupId>
                <artifactId>yokeos-tool</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yokeos</groupId>
                <artifactId>yokeos-channel-cli</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yokeos</groupId>
                <artifactId>yokeos-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yokeos</groupId>
                <artifactId>yokeos-storage</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yokeos</groupId>
                <artifactId>yokeos-cli</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yokeos</groupId>
                <artifactId>yokeos-boot</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- OpenAPI / Swagger UI -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- Structured JSON logging (prod profile) -->
            <dependency>
                <groupId>net.logstash.logback</groupId>
                <artifactId>logstash-logback-encoder</artifactId>
                <version>${logstash-logback.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Tests: exclude @Tag("integration") by default (AI 编程指南 §5.1: 集成测试默认
                     排除、显式触发); run locally with: mvn test -Dgroups=integration -DexcludedGroups= -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <excludedGroups>${excludedGroups}</excludedGroups>
                    </configuration>
                </plugin>

                <!-- Format: Spotless + google-java-format. "Looks like" is settled by a tool that
                     can auto-fix, so humans never review formatting. Check fails fast at validate,
                     before compile/test. -->
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless.version}</version>
                    <configuration>
                        <java>
                            <googleJavaFormat>
                                <style>GOOGLE</style>
                            </googleJavaFormat>
                            <removeUnusedImports/>
                            <importOrder/>
                            <trimTrailingWhitespace/>
                            <endWithNewline/>
                        </java>
                    </configuration>
                    <executions>
                        <execution>
                            <phase>validate</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- Coding rules: Alibaba P3C on top of PMD (PMD 6.x for P3C compatibility). -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-pmd-plugin</artifactId>
                    <version>${maven-pmd-plugin.version}</version>
                    <configuration>
                        <!-- PMD 6.55 (newest that P3C 2.1.1 supports) parses at most Java 19
                             grammar, so parse at the 17 level. Code must avoid Java 18+ *syntax*
                             (record patterns, pattern switch); records/sealed are fine.
                             AI 编程指南 §5.1: 解析失败等于构建失败，宁可禁用写法不给门禁开洞。 -->
                        <targetJdk>17</targetJdk>
                        <printFailingErrors>true</printFailingErrors>
                        <skipPmdError>false</skipPmdError>
                        <linkXRef>false</linkXRef>
                        <analysisCache>true</analysisCache>
                        <rulesets>
                            <ruleset>rulesets/java/ali-naming.xml</ruleset>
                            <ruleset>rulesets/java/ali-oop.xml</ruleset>
                            <ruleset>rulesets/java/ali-concurrent.xml</ruleset>
                            <ruleset>rulesets/java/ali-exception.xml</ruleset>
                            <ruleset>rulesets/java/ali-constant.xml</ruleset>
                            <ruleset>rulesets/java/ali-flowcontrol.xml</ruleset>
                            <ruleset>rulesets/java/ali-set.xml</ruleset>
                            <ruleset>rulesets/java/ali-other.xml</ruleset>
                        </rulesets>
                    </configuration>
                    <dependencies>
                        <!-- Upgrade ASM ahead of PMD 6.55's bundled copy: the old one throws
                             "Unsupported class file major version 65" when type resolution reads
                             Java 21 bytecode. ASM 9.7 understands class v65. -->
                        <dependency>
                            <groupId>org.ow2.asm</groupId>
                            <artifactId>asm</artifactId>
                            <version>9.7</version>
                        </dependency>
                        <dependency>
                            <groupId>net.sourceforge.pmd</groupId>
                            <artifactId>pmd-core</artifactId>
                            <version>${pmd.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>net.sourceforge.pmd</groupId>
                            <artifactId>pmd-java</artifactId>
                            <version>${pmd.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>com.alibaba.p3c</groupId>
                            <artifactId>p3c-pmd</artifactId>
                            <version>${p3c.version}</version>
                        </dependency>
                    </dependencies>
                    <executions>
                        <execution>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- Fallback style gate: Checkstyle (google_checks), errors only. The config file
                     resolves from inside the checkstyle jar, so config version always matches
                     the checkstyle version. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-checkstyle-plugin</artifactId>
                    <version>${maven-checkstyle-plugin.version}</version>
                    <configuration>
                        <configLocation>google_checks.xml</configLocation>
                        <!-- google_checks ≥10.x marks every violation "warning" by default
                             (${org.checkstyle.google.severity}). Without promoting it, the
                             error-severity filter below swallows everything and this gate never
                             fires — the reference implementation's checkstyle is silently
                             dormant for exactly this reason (constitution 9: 结构照抄，
                             瑕疵不继承). -->
                        <propertyExpansion>org.checkstyle.google.severity=error</propertyExpansion>
                        <violationSeverity>error</violationSeverity>
                        <failOnViolation>true</failOnViolation>
                        <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    </configuration>
                    <dependencies>
                        <dependency>
                            <groupId>com.puppycrawl.tools</groupId>
                            <artifactId>checkstyle</artifactId>
                            <version>${checkstyle.version}</version>
                        </dependency>
                    </dependencies>
                    <executions>
                        <execution>
                            <id>checkstyle-validate</id>
                            <phase>validate</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- Security: SpotBugs + Find Security Bugs (OWASP Top 10 coverage). -->
                <plugin>
                    <groupId>com.github.spotbugs</groupId>
                    <artifactId>spotbugs-maven-plugin</artifactId>
                    <version>${spotbugs-maven-plugin.version}</version>
                    <configuration>
                        <effort>Max</effort>
                        <threshold>Low</threshold>
                        <plugins>
                            <plugin>
                                <groupId>com.h3xstream.findsecbugs</groupId>
                                <artifactId>findsecbugs-plugin</artifactId>
                                <version>${findsecbugs.version}</version>
                            </plugin>
                        </plugins>
                    </configuration>
                    <dependencies>
                        <dependency>
                            <groupId>com.github.spotbugs</groupId>
                            <artifactId>spotbugs</artifactId>
                            <version>${spotbugs.version}</version>
                        </dependency>
                    </dependencies>
                    <executions>
                        <execution>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- Security: OWASP Dependency-Check (CVE scan of third-party deps). Skipped by
                     default (owasp.skip); CI runs it as a separate job with -Dowasp.skip=false.
                     The nightly NVD cache feed works without an NVD API key. -->
                <plugin>
                    <groupId>org.owasp</groupId>
                    <artifactId>dependency-check-maven</artifactId>
                    <version>${dependency-check.version}</version>
                    <configuration>
                        <skip>${owasp.skip}</skip>
                        <failBuildOnCVSS>8</failBuildOnCVSS>
                        <nvdDatafeedUrl>${nvd.datafeed.url}</nvdDatafeedUrl>
                        <!-- OSS Index needs per-user credentials; NVD and CISA stay enabled. -->
                        <ossIndexAnalyzerEnabled>false</ossIndexAnalyzerEnabled>
                        <suppressionFile>${maven.multiModuleProjectDirectory}/config/dependency-check-suppressions.xml</suppressionFile>
                        <formats>
                            <format>HTML</format>
                            <format>JSON</format>
                        </formats>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
