<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.yokeos</groupId>
        <artifactId>yokeos</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>yokeos-memory</artifactId>
    <name>YokeOS Memory</name>
    <description>核心能力三（记忆）：MemoryService 统一门面、LongTermMemoryStore 可插拔三档后端（markdown / sqlite / mem0）、MemoryTools（save/recall）。随第 22 节落地。</description>

    <dependencies>
        <dependency>
            <groupId>com.yokeos</groupId>
            <artifactId>yokeos-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yokeos</groupId>
            <artifactId>yokeos-storage</artifactId>
        </dependency>
        <!-- 第 22 节（specs/007）：MemoryTools 经 ToolRegistry.registerAnnotated 注册——依赖注册面与
             AnnotatedToolAdapter 管道（specs/006 裁决二：依赖方向 memory → tool 单向无环，不触宪法 5）。 -->
        <dependency>
            <groupId>com.yokeos</groupId>
            <artifactId>yokeos-tool</artifactId>
        </dependency>
        <!-- 第 22 节 mem0 档（specs/007）：RestClient 同步 HTTP 客户端（宪法 4 合规）。既有坐标的模块级新增，
             版本走 Boot BOM——非新外部坐标（软门禁⑥记实施偏差：research D2 已 javap 核实 API）。 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <!-- SpotBugs 抑制注解（core 同款 provided：仅编译期可见） -->
        <dependency>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-annotations</artifactId>
            <version>${spotbugs.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
