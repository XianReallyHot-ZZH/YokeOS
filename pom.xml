<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.yokeos</groupId>
    <artifactId>yokeos</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>YokeOS</name>
    <description>企业级 Agent Harness OS</description>

    <properties>
        <java.version>21</java.version>

        <!-- 版本锁自 docs/TechnicalSolution.md §1.2。地基期尚无任何模块消费它们（依赖本体随
             第 16+ 节落地）；先把版本钉在这里，后续节次引入时全仓解析到同一版本。 -->
        <spring-ai.version>1.1.8</spring-ai.version>
        <picocli.version>4.7.6</picocli.version>
        <sqlite-jdbc.version>3.53.2.1</sqlite-jdbc.version>

        <!-- 地基实际消费的基础设施 -->
        <springdoc.version>2.6.0</springdoc.version>
        <logstash-logback.version>7.4</logstash-logback.version>

        <!-- 同一 Boot 3.5.16 基线上的 CVE 补丁覆盖。jackson-bom 2.21.5 / log4j2 2.25.5 镜像
             参照库的钉版（宪法 9）；tomcat 走得更远：参照钉 10.1.57，但其钉版之后披露的
             CVE 仍打到 ≥8 分，故取 10.1.x 补丁线最新（10.1.59）以清零门禁。这三个属性名
             是 Boot parent 自己的；只随一次新的 dependency-check 扫描一起调，不许随手改。 -->
        <jackson-bom.version>2.21.5</jackson-bom.version>
        <log4j2.version>2.25.5</log4j2.version>
        <tomcat.version>10.1.59</tomcat.version>

        <!-- 质量 / 格式 / 安全门禁：版本组合镜像参照实现（宪法 9：结构照抄）。这套确切组合
             已在 JDK 21 + Boot 3.5.x 上验证；不许单独升级某一项——P3C 2.1.1 锁死 PMD 6.x，
             见 PMD 插件处的注释。 -->
        <spotless.version>2.43.0</spotless.version>
        <maven-pmd-plugin.version>3.21.2</maven-pmd-plugin.version>
        <pmd.version>6.55.0</pmd.version>
        <p3c.version>2.1.1</p3c.version>
        <maven-checkstyle-plugin.version>3.5.0</maven-checkstyle-plugin.version>
        <checkstyle.version>10.18.2</checkstyle.version>
        <spotbugs-maven-plugin.version>4.8.6.4</spotbugs-maven-plugin.version>
        <spotbugs.version>4.8.6</spotbugs.version>
        <findsecbugs.version>1.13.0</findsecbugs.version>
        <dependency-check.version>12.2.2</dependency-check.version>
        <nvd.datafeed.url>https://dependency-check.github.io/DependencyCheck_Builder/nvd_cache/</nvd.datafeed.url>

        <!-- OWASP Dependency-Check 默认 skip 换本地构建速度，CI 里再开启。 -->
        <owasp.skip>true</owasp.skip>
        <!-- 集成测试保持显式触发（@Tag("integration") 默认排除；本地跑：
             mvn test -Dgroups=integration -DexcludedGroups=）。AI 编程指南 §5.1。 -->
        <excludedGroups>integration</excludedGroups>
    </properties>

    <modules>
        <module>yokeos-core</module>
        <module>yokeos-provider</module>
        <module>yokeos-memory</module>
        <module>yokeos-tool</module>
        <module>yokeos-channel-cli</module>
        <module>yokeos-web</module>
        <module>yokeos-storage</module>
        <module>yokeos-cli</module>
        <module>yokeos-boot</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- 内部模块：跨模块依赖一律走这里登记，下游引用保持 ${project.version} 同版本。 -->
            <dependency>
                <groupId>com.yokeos</groupId>
                <artifactId>yokeos-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yokeos</groupId>
                <artifactId>yokeos-provider</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yokeos</groupId>
                <artifactId>yokeos-memory</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yokeos</groupId>
                <artifactId>yokeos-tool</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yokeos</groupId>
                <artifactId>yokeos-channel-cli</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yokeos</groupId>
                <artifactId>yokeos-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yokeos</groupId>
                <artifactId>yokeos-storage</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yokeos</groupId>
                <artifactId>yokeos-cli</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yokeos</groupId>
                <artifactId>yokeos-boot</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- OpenAPI / Swagger UI 文档 -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- 结构化 JSON 日志（prod profile） -->
            <dependency>
                <groupId>net.logstash.logback</groupId>
                <artifactId>logstash-logback-encoder</artifactId>
                <version>${logstash-logback.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- 测试：@Tag("integration") 默认排除（AI 编程指南 §5.1：集成测试默认排除、
                     显式触发）；本地跑：mvn test -Dgroups=integration -DexcludedGroups= -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <excludedGroups>${excludedGroups}</excludedGroups>
                    </configuration>
                </plugin>

                <!-- 格式：Spotless + google-java-format。「长什么样」交给能自动修的工具裁决，
                     人不做任何格式类 review。check 提前到 validate，先于编译/测试快失败。 -->
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless.version}</version>
                    <configuration>
                        <java>
                            <googleJavaFormat>
                                <style>GOOGLE</style>
                            </googleJavaFormat>
                            <removeUnusedImports/>
                            <importOrder/>
                            <trimTrailingWhitespace/>
                            <endWithNewline/>
                        </java>
                    </configuration>
                    <executions>
                        <execution>
                            <phase>validate</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- 编码规约：阿里 P3C 规约集跑在 PMD 之上（P3C 兼容性锁死 PMD 6.x）。 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-pmd-plugin</artifactId>
                    <version>${maven-pmd-plugin.version}</version>
                    <configuration>
                        <!-- PMD 6.55（P3C 2.1.1 支持的上限）语法解析最高到 Java 19，故按 17 级解析。
                             代码须避开 Java 18+ 语法（record patterns、pattern switch）；
                             record / sealed 不受影响。AI 编程指南 §5.1：解析失败等于构建失败，
                             宁可禁用写法，不给门禁开洞。 -->
                        <targetJdk>17</targetJdk>
                        <printFailingErrors>true</printFailingErrors>
                        <skipPmdError>false</skipPmdError>
                        <linkXRef>false</linkXRef>
                        <analysisCache>true</analysisCache>
                        <rulesets>
                            <ruleset>rulesets/java/ali-naming.xml</ruleset>
                            <ruleset>rulesets/java/ali-oop.xml</ruleset>
                            <ruleset>rulesets/java/ali-concurrent.xml</ruleset>
                            <ruleset>rulesets/java/ali-exception.xml</ruleset>
                            <ruleset>rulesets/java/ali-constant.xml</ruleset>
                            <ruleset>rulesets/java/ali-flowcontrol.xml</ruleset>
                            <ruleset>rulesets/java/ali-set.xml</ruleset>
                            <ruleset>rulesets/java/ali-other.xml</ruleset>
                        </rulesets>
                    </configuration>
                    <dependencies>
                        <!-- ASM 升到 PMD 6.55 自带版本之前：旧版在类型解析读到 Java 21 字节码时抛
                             "Unsupported class file major version 65"。ASM 9.7 认识 class v65。 -->
                        <dependency>
                            <groupId>org.ow2.asm</groupId>
                            <artifactId>asm</artifactId>
                            <version>9.7</version>
                        </dependency>
                        <dependency>
                            <groupId>net.sourceforge.pmd</groupId>
                            <artifactId>pmd-core</artifactId>
                            <version>${pmd.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>net.sourceforge.pmd</groupId>
                            <artifactId>pmd-java</artifactId>
                            <version>${pmd.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>com.alibaba.p3c</groupId>
                            <artifactId>p3c-pmd</artifactId>
                            <version>${p3c.version}</version>
                        </dependency>
                    </dependencies>
                    <executions>
                        <execution>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- 风格兜底门禁：Checkstyle（google_checks），仅 error 级拦截。配置文件从
                     checkstyle jar 内部解析，规则集版本永远与引擎版本一致。 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-checkstyle-plugin</artifactId>
                    <version>${maven-checkstyle-plugin.version}</version>
                    <configuration>
                        <configLocation>google_checks.xml</configLocation>
                        <!-- google_checks ≥10.x 默认把所有违规记为 warning
                             （${org.checkstyle.google.severity}）。不在这里升成 error，下面的
                             error 级过滤会把违规全吞掉、门禁永不触发——参照库的 Checkstyle
                             正因此悄悄哑火（宪法 9：结构照抄，瑕疵不继承）。第二行注入
                             google_checks 内置 optional SuppressionFilter 的豁免清单
                             （中文工具盲区的定点豁免，见 config/checkstyle-suppressions.xml）。 -->
                        <propertyExpansion>org.checkstyle.google.severity=error
org.checkstyle.google.suppressionfilter.config=${maven.multiModuleProjectDirectory}/config/checkstyle-suppressions.xml</propertyExpansion>
                        <violationSeverity>error</violationSeverity>
                        <failOnViolation>true</failOnViolation>
                        <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    </configuration>
                    <dependencies>
                        <dependency>
                            <groupId>com.puppycrawl.tools</groupId>
                            <artifactId>checkstyle</artifactId>
                            <version>${checkstyle.version}</version>
                        </dependency>
                    </dependencies>
                    <executions>
                        <execution>
                            <id>checkstyle-validate</id>
                            <phase>validate</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- 安全：SpotBugs + Find Security Bugs（OWASP Top 10 漏洞模式覆盖）。 -->
                <plugin>
                    <groupId>com.github.spotbugs</groupId>
                    <artifactId>spotbugs-maven-plugin</artifactId>
                    <version>${spotbugs-maven-plugin.version}</version>
                    <configuration>
                        <effort>Max</effort>
                        <threshold>Low</threshold>
                        <plugins>
                            <plugin>
                                <groupId>com.h3xstream.findsecbugs</groupId>
                                <artifactId>findsecbugs-plugin</artifactId>
                                <version>${findsecbugs.version}</version>
                            </plugin>
                        </plugins>
                    </configuration>
                    <dependencies>
                        <dependency>
                            <groupId>com.github.spotbugs</groupId>
                            <artifactId>spotbugs</artifactId>
                            <version>${spotbugs.version}</version>
                        </dependency>
                    </dependencies>
                    <executions>
                        <execution>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- 安全：OWASP Dependency-Check（第三方依赖的 CVE 扫描）。默认 skip
                     （owasp.skip）；CI 独立 job 以 -Dowasp.skip=false 开启。
                     夜间 NVD 缓存源无需 NVD API key。 -->
                <plugin>
                    <groupId>org.owasp</groupId>
                    <artifactId>dependency-check-maven</artifactId>
                    <version>${dependency-check.version}</version>
                    <configuration>
                        <skip>${owasp.skip}</skip>
                        <failBuildOnCVSS>8</failBuildOnCVSS>
                        <nvdDatafeedUrl>${nvd.datafeed.url}</nvdDatafeedUrl>
                        <!-- OSS Index 需要个人凭证；NVD 与 CISA 保持启用。 -->
                        <ossIndexAnalyzerEnabled>false</ossIndexAnalyzerEnabled>
                        <suppressionFile>${maven.multiModuleProjectDirectory}/config/dependency-check-suppressions.xml</suppressionFile>
                        <formats>
                            <format>HTML</format>
                            <format>JSON</format>
                        </formats>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
