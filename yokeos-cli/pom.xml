<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.yokeos</groupId>
        <artifactId>yokeos</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>yokeos-cli</artifactId>
    <name>YokeOS CLI</name>
    <description>命令行入口：Picocli 主入口、12 个子命令、ConfigLoader。地基交付 ConfigLoader（${ENV_VAR} 解析 + 启动校验）；CLI 主类与子命令随第 16/18 节落地。</description>

    <dependencies>
        <dependency>
            <groupId>com.yokeos</groupId>
            <artifactId>yokeos-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yokeos</groupId>
            <artifactId>yokeos-channel-cli</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yokeos</groupId>
            <artifactId>yokeos-provider</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yokeos</groupId>
            <artifactId>yokeos-storage</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yokeos</groupId>
            <artifactId>yokeos-tool</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yokeos</groupId>
            <artifactId>yokeos-memory</artifactId>
        </dependency>
        <!-- CLI 入口（Picocli 4.7.6，技术栈表）；init 纯文件操作不启 Spring（宪法 4）。 -->
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>${picocli.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- 第 18 节（research D7 实证）：重命令 Spring 装配面 YokeosRuntime 落本模块
             （boot 聚合依赖全部九模块，cli 反向依赖 boot 即循环依赖）；Boot 自家 starter
             不触发宪法 2 坑——classpath 无 spring-ai autoconfigure（16 节裸 spring-ai-openai）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- 轻命令直读（零 Spring）：provider list 解析 application.yaml、session list 纯 JDBC。 -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
