<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.yokeos</groupId>
        <artifactId>yokeos</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>yokeos-boot</artifactId>
    <name>YokeOS Boot</name>
    <description>Spring Boot 启动模块：应用主类、配置（虚拟线程、actuator、日志）、依赖聚合。产出可部署的 fat JAR。</description>

    <dependencies>
        <dependency>
            <groupId>com.yokeos</groupId>
            <artifactId>yokeos-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yokeos</groupId>
            <artifactId>yokeos-provider</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yokeos</groupId>
            <artifactId>yokeos-memory</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yokeos</groupId>
            <artifactId>yokeos-tool</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yokeos</groupId>
            <artifactId>yokeos-channel-cli</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yokeos</groupId>
            <artifactId>yokeos-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yokeos</groupId>
            <artifactId>yokeos-storage</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yokeos</groupId>
            <artifactId>yokeos-cli</artifactId>
        </dependency>

        <!-- 可观测性 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- 结构化 JSON 日志（prod profile） -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 上下文装载测试把 SQLite 指到 target/（测试 cwd 无 .yokeos/，SQLite 不建父目录） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <yokeos.db.dir>target</yokeos.db.dir>
                    </systemPropertyVariables>
                    <!-- 第 18 节：YokeosBootApplication 组件扫描吸收 YokeosRuntime 后，providerMap
                         启动即校验 ${ENV} 占位对应的环境变量（16 节 FR7）。测试给哑值——只验存在性，
                         不真调模型（真 key 走 ReActSmokeIntegrationTest 的 assumeTrue 路径）。 -->
                    <environmentVariables>
                        <DEEPSEEK_API_KEY>sk-test-dummy-boot-load</DEEPSEEK_API_KEY>
                        <KIMI_API_KEY>sk-test-dummy-boot-load</KIMI_API_KEY>
                    </environmentVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- 第 18 节起 mainClass 切到 Picocli CLI 入口 YokeOsCli（CLI 参数直达子命令；
                         YokeosBootApplication 保留供 26 节 serve。坑表：fat JAR mainClass 不指 CLI 入口，
                         java -jar ... chat 的参数就进不了 Picocli）。 -->
                    <mainClass>com.yokeos.cli.YokeOsCli</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
